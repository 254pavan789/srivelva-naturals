# ── Sri Velva Naturals — Frontend Environment ────────────────────────────────
# Copy this file to .env and fill in your values.
#
# IMPORTANT: The frontend can run WITHOUT a backend.
# All 26 products are available as static fallback data when backend is offline.
# To enable full functionality (cart, orders, admin), connect the Spring Boot backend.

# ── API Backend URL ──────────────────────────────────────────────────────────
# Development: Leave EMPTY — Vite proxy routes /api → localhost:8080
# Production:  Set to your deployed backend URL (Render, Railway, VPS, etc.)
#
# Example (Render.com free tier):
#   VITE_API_BASE_URL=https://sri-velva-backend.onrender.com
#
# Example (Railway):
#   VITE_API_BASE_URL=https://sri-velva-backend.up.railway.app
#
# VITE_API_BASE_URL=https://your-backend-url.com

# ── WhatsApp ─────────────────────────────────────────────────────────────────
VITE_WHATSAPP_NUMBER=9944268288
