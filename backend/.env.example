# ── Sri Velva Naturals — Backend Environment Variables ──────────────────
# Copy this file to a .env and set the values, OR export them as shell
# environment variables before running: mvn spring-boot:run
#
# These map to ${VAR_NAME:defaultValue} placeholders in application.properties.
# Never commit real credentials to version control.

# ── MySQL Database ──────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/srivelva?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=yourpassword

# ── Server ──────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── CORS — comma-separated list of allowed frontend origins ─────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Admin Credentials ───────────────────────────────────────────────────
# Change these before going live!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_JWT_SECRET=change-this-to-a-random-32+-char-string-in-production

# ── Razorpay Payment Gateway ─────────────────────────────────────────────
#
# HOW TO GET YOUR KEYS (free, takes 2 minutes):
#   1. Sign up at https://dashboard.razorpay.com
#   2. Go to Settings → API Keys → Generate Test Key
#   3. Copy the Key ID (starts with rzp_test_) → RAZORPAY_KEY
#   4. Copy the Key Secret                      → RAZORPAY_SECRET
#
# TEST KEY  → works with test UPI / test cards. No real money charged.
# LIVE KEY  → requires KYC. Use only in production.
#
# If these are not set (or left as placeholder), the backend returns HTTP 503
# for /api/payment/create-order and the frontend gracefully falls back to
# showing "use Cash on Delivery" (or Demo Mode if VITE_PAYMENT_DEMO_MODE=true).
#
RAZORPAY_KEY=rzp_test_your_key_id_here
RAZORPAY_SECRET=your_razorpay_key_secret_here

# ── Email / SMTP ─────────────────────────────────────────────────────────
# Gmail SMTP (recommended for small volume):
#   1. Enable 2-Step Verification: myaccount.google.com/security
#   2. Create App Password:        myaccount.google.com/apppasswords
#   3. Set below (16 chars, no spaces)
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# ── Twilio WhatsApp (optional) ──────────────────────────────────────────
# Only needed if you want automated WhatsApp notifications to the admin.
# Leave as "mock" to disable without errors.
TWILIO_ACCOUNT_SID=mock
TWILIO_AUTH_TOKEN=mock
TWILIO_FROM_NUMBER=whatsapp:+14155238886
TWILIO_ADMIN_PHONE=whatsapp:+919944268288
